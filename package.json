{
  "name": "breathe-safe",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "cross-env TS_NODE_PROJECT=tsconfig.server.json ts-node server.ts",
    "build": "next build && tsc -p tsconfig.server.json",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "build:standalone": "next build --standalone",
    "build:local": "npm run build:standalone && npm run copy-assets",
    "copy-assets": "node scripts/copy-assets.js",
    "start:local": "node standalone/server.js",
    "serve": "npm run build:local && npm run start:local"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.2",
    "@prisma/client": "^6.16.1",
    "axios": "^1.11.0",
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "framer-motion": "^12.23.12",
    "next": "15.5.2",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "prisma": "^6.16.1",
    "react": "19.1.0",
    "react-circular-progressbar": "^2.2.0",
    "react-d3-speedometer": "^3.1.1",
    "react-date-range": "^2.0.1",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "recharts": "^3.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tedious": "^18.6.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/express": "^5.0.3",
    "@types/node": "^20.19.14",
    "@types/react": "^19",
    "@types/react-date-range": "^1.4.10",
    "@types/react-dom": "^19",
    "cross-env": "^10.0.0",
    "nodemon": "^3.1.10",
    "tailwindcss": "^4.1.13",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
